# Copy to .env and fill in. scripts/init-env.sh does this and generates the secrets.
# Never commit .env.

# --- Address -------------------------------------------------------------------------------
# Local: http://localhost, http://127.0.0.1. Production: your domain, e.g. mahlzeit.example.org (Caddy gets TLS).
SITE_ADDRESS=http://localhost, http://127.0.0.1
# The public URL people open. Drives links in emails and invites, cookies, push and the connector.
BASE_URL=http://localhost
# Change only if 80/443 are taken on this machine.
HTTP_PORT=80
HTTPS_PORT=443

# --- Secrets (generate with: docker compose run --rm --no-deps app mahlzeit gen-secrets) ----
POSTGRES_PASSWORD=
ENCRYPTION_KEY=
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
# Optional contact for push services, e.g. mailto:you@example.org (default: BASE_URL when https)
VAPID_SUBJECT=

# --- Email (optional: enables password reset by email) -------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# starttls | ssl | none
SMTP_SECURITY=starttls

# --- Open Food Facts (barcode lookups; optional) ------------------------------------------
# Contact sent in the User-Agent, as Open Food Facts asks (default: BASE_URL), e.g. mailto:you@example.org
OFF_CONTACT=
# false: no lookups at all; unknown barcodes go straight to the label form.
OFF_ENABLED=true
# Only the end-to-end tests point these at the stub (http://offstub:8080).
OFF_BASE_URL=https://world.openfoodfacts.org
OFF_SEARCH_URL=https://search.openfoodfacts.org

# --- Backups -------------------------------------------------------------------------------
# age public key (age1...). Backups are encrypted to it; keep the private key OFF this server.
BACKUP_AGE_RECIPIENT=
BACKUP_KEEP=14
# Where backups are written on this machine.
BACKUP_DIR=./backups

# --- Tuning (optional) ---------------------------------------------------------------------
LOG_LEVEL=INFO
WEB_CONCURRENCY=2
# Extra origins allowed to send requests, e.g. the Vite dev server: http://localhost:5173
EXTRA_ORIGINS=
